
using System;
using System.Data;
using System.Data.OleDb;
using System.Windows.Forms;

namespace Practicle5A
{
    public partial class Form1 : Form
    {
        OleDbConnection con = new OleDbConnection(
@"Provider=Microsoft.Jet.OLEDB.4.0;Data Source=C:\school.mdb");

        OleDbDataAdapter da;
        DataSet ds = new DataSet();

        int inc = 0;
        int maxRows = 0;
        bool isNew = false;

        public Form1()
        {
            InitializeComponent();

            // Connect Form Load event
            this.Load -= Form1_Load;
            this.Load += Form1_Load;

            // Connect all button Click events
            button1.Click -= button1_Click_1;
            button1.Click += button1_Click_1;

            button2.Click -= button2_Click_1;
            button2.Click += button2_Click_1;

            button3.Click -= button3_Click_1;
            button3.Click += button3_Click_1;

            button4.Click -= button4_Click_1;
            button4.Click += button4_Click_1;

            button5.Click -= button5_Click_1;
            button5.Click += button5_Click_1;

            button6.Click -= button6_Click_1;
            button6.Click += button6_Click_1;

            button7.Click -= button7_Click_1;
            button7.Click += button7_Click_1;

            button8.Click -= button8_Click_1;
            button8.Click += button8_Click_1;

            button9.Click -= button9_Click_1;
            button9.Click += button9_Click_1;
        }

        private void Form1_Load(object sender, EventArgs e)
        {
            label1.Text = "Course No";
            label2.Text = "Course Name";
            label3.Text = "Duration";
            label4.Text = "Fees";

            LoadData();
        }

        private void LoadData()
        {
            try
            {
                ds.Clear();

                da = new OleDbDataAdapter(
                    "SELECT * FROM course ORDER BY cno", con);

                // INSERT COMMAND
                da.InsertCommand = new OleDbCommand(
                    "INSERT INTO course (cno, name, duration, fees) VALUES (?, ?, ?, ?)", con);

                da.InsertCommand.Parameters.Add(
                    "cno", OleDbType.Integer, 0, "cno");

                da.InsertCommand.Parameters.Add(
                    "name", OleDbType.VarChar, 50, "name");

                da.InsertCommand.Parameters.Add(
                    "duration", OleDbType.Integer, 0, "duration");

                da.InsertCommand.Parameters.Add(
                    "fees", OleDbType.Integer, 0, "fees");


                // UPDATE COMMAND
                da.UpdateCommand = new OleDbCommand(
                    "UPDATE course SET name = ?, duration = ?, fees = ? WHERE cno = ?", con);

                da.UpdateCommand.Parameters.Add(
                    "name", OleDbType.VarChar, 50, "name");

                da.UpdateCommand.Parameters.Add(
                    "duration", OleDbType.Integer, 0, "duration");

                da.UpdateCommand.Parameters.Add(
                    "fees", OleDbType.Integer, 0, "fees");

                OleDbParameter updateKey =
                    da.UpdateCommand.Parameters.Add(
                    "cno", OleDbType.Integer, 0, "cno");

                updateKey.SourceVersion = DataRowVersion.Original;


                // DELETE COMMAND
                da.DeleteCommand = new OleDbCommand(
                    "DELETE FROM course WHERE cno = ?", con);

                OleDbParameter deleteKey =
                    da.DeleteCommand.Parameters.Add(
                    "cno", OleDbType.Integer, 0, "cno");

                deleteKey.SourceVersion = DataRowVersion.Original;


                // FILL DATASET
                da.Fill(ds, "course");

                maxRows = ds.Tables["course"].Rows.Count;

                listBox1.Items.Clear();

                for (int i = 0; i < maxRows; i++)
                {
                    listBox1.Items.Add(
                        ds.Tables["course"].Rows[i]["name"].ToString());
                }

                if (maxRows > 0)
                {
                    inc = 0;
                    NavigateRecords();
                }
                else
                {
                    textBox1.Clear();
                    textBox2.Clear();
                    textBox3.Clear();
                    textBox4.Clear();
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("Database Error: " + ex.Message);
            }
        }

        private void NavigateRecords()
        {
            if (maxRows > 0 && inc >= 0 && inc < maxRows)
            {
                DataRow dRow = ds.Tables["course"].Rows[inc];

                textBox1.Text = dRow["cno"].ToString();
                textBox2.Text = dRow["name"].ToString();
                textBox3.Text = dRow["duration"].ToString();
                textBox4.Text = dRow["fees"].ToString();

                listBox1.SelectedIndex = inc;
            }
        }

        // FIRST RECORD
        private void button1_Click_1(object sender, EventArgs e)
        {
            if (maxRows > 0)
            {
                inc = 0;
                NavigateRecords();
            }
        }

        // NEXT RECORD
        private void button2_Click_1(object sender, EventArgs e)
        {
            if (inc < maxRows - 1)
            {
                inc++;
                NavigateRecords();
            }
            else
            {
                MessageBox.Show("No More Rows");
            }
        }

        // LAST RECORD
        private void button3_Click_1(object sender, EventArgs e)
        {
            if (maxRows > 0)
            {
                inc = maxRows - 1;
                NavigateRecords();
            }
        }

        // PREVIOUS RECORD
        private void button4_Click_1(object sender, EventArgs e)
        {
            if (inc > 0)
            {
                inc--;
                NavigateRecords();
            }
            else
            {
                MessageBox.Show("First Record");
            }
        }

        // ADD NEW RECORD
        private void button5_Click_1(object sender, EventArgs e)
        {
            textBox1.Clear();
            textBox2.Clear();
            textBox3.Clear();
            textBox4.Clear();

            isNew = true;
            textBox1.Focus();
        }

        // EDIT RECORD
        private void button6_Click_1(object sender, EventArgs e)
        {
            if (maxRows > 0)
            {
                isNew = false;
                textBox2.Focus();
            }
            else
            {
                MessageBox.Show("No Record Available");
            }
        }

        // DELETE RECORD
        private void button7_Click_1(object sender, EventArgs e)
        {
            if (maxRows > 0)
            {
                DialogResult result = MessageBox.Show(
                    "Do you want to delete this record?",
                    "Confirm Delete",
                    MessageBoxButtons.YesNo);

                if (result == DialogResult.Yes)
                {
                    try
                    {
                        ds.Tables["course"].Rows[inc].Delete();

                        da.Update(ds, "course");

                        MessageBox.Show("Record Deleted");

                        LoadData();
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show("Delete Error: " + ex.Message);
                    }
                }
            }
            else
            {
                MessageBox.Show("No Record Available");
            }
        }

        // SAVE RECORD
        private void button8_Click_1(object sender, EventArgs e)
        {
            int cno, duration, fees;

            if (!int.TryParse(textBox1.Text, out cno) ||
                !int.TryParse(textBox3.Text, out duration) ||
                !int.TryParse(textBox4.Text, out fees) ||
                textBox2.Text.Trim() == "")
            {
                MessageBox.Show("Please enter valid course details.");
                return;
            }

            try
            {
                if (isNew)
                {
                    DataRow dRow = ds.Tables["course"].NewRow();

                    dRow["cno"] = cno;
                    dRow["name"] = textBox2.Text;
                    dRow["duration"] = duration;
                    dRow["fees"] = fees;

                    ds.Tables["course"].Rows.Add(dRow);

                    da.Update(ds, "course");

                    MessageBox.Show("New Record Saved");

                    isNew = false;
                }
                else
                {
                    if (maxRows == 0)
                    {
                        MessageBox.Show("Click Add New first.");
                        return;
                    }

                    DataRow dRow = ds.Tables["course"].Rows[inc];

                    dRow["cno"] = cno;
                    dRow["name"] = textBox2.Text;
                    dRow["duration"] = duration;
                    dRow["fees"] = fees;

                    da.Update(ds, "course");

                    MessageBox.Show("Record Updated");
                }

                LoadData();
            }
            catch (Exception ex)
            {
                MessageBox.Show("Save Error: " + ex.Message);
            }
        }

        // CANCEL
        private void button9_Click_1(object sender, EventArgs e)
        {
            isNew = false;

            if (maxRows > 0)
            {
                NavigateRecords();
            }
            else
            {
                textBox1.Clear();
                textBox2.Clear();
                textBox3.Clear();
                textBox4.Clear();
            }
        }
    }
}
